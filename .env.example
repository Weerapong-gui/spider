# Copy to .env at the repository root and fill in. .env is git-ignored; never
# commit real values. Pass it explicitly, because Compose looks in docker/:
#   docker compose --env-file .env -f docker/compose.yml up -d --build

# The Tailscale address of this machine. Get it with: tailscale ip -4
# Do not use 0.0.0.0 -- that publishes spider on every interface.
SPIDER_BIND_IP=100.95.121.2

# Where the blobs and the database live on the host.
# The leading dot hides it from the Samba share on /mnt/nas.
SPIDER_HOST_DATA_DIR=/mnt/nas/.spider

# At least 32 characters. Generate one with: openssl rand -base64 32
SPIDER_TOKEN=

# Refuse uploads once free space drops below this. Other containers share this
# disk, and a full disk corrupts their databases, not just spider's.
SPIDER_MIN_FREE_GB=10

# Largest single upload in MB. 0 means no limit.
SPIDER_MAX_ITEM_MB=0

# Must match the owner of SPIDER_HOST_DATA_DIR, or the files land owned by root.
SPIDER_UID=1000
SPIDER_GID=1000
